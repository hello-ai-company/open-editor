{
  "name": "@hello-ai-company/editor-ai",
  "version": "0.2.0",
  "description": "Provider-neutral agent, suggestion, and explicit learning contracts for OpenEditor.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-ai-company/open-editor.git",
    "directory": "packages/ai"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "build": "npm run build -w @hello-ai-company/editor-core && tsc -p tsconfig.build.json",
    "typecheck": "npm run build -w @hello-ai-company/editor-core && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@hello-ai-company/editor-core": "^0.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
