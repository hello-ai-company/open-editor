{
  "name": "@hello-ai-company/editor-blocknote",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "OpenEditor BlockNote power layer: adapter, schema, commands, document index, navigation, and optional math/diagram/code. Unpublished.",
  "keywords": [
    "blocknote",
    "editor",
    "adapter",
    "open-editor",
    "document-model"
  ],
  "homepage": "https://github.com/hello-ai-company/open-editor/tree/main/packages/blocknote#readme",
  "bugs": {
    "url": "https://github.com/hello-ai-company/open-editor/issues"
  },
  "author": "Yuki Shibata",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./math": {
      "types": "./dist/math/index.d.ts",
      "import": "./dist/math/index.js"
    },
    "./diagram": {
      "types": "./dist/diagram/index.d.ts",
      "import": "./dist/diagram/index.js"
    },
    "./code": {
      "types": "./dist/code/index.d.ts",
      "import": "./dist/code/index.js"
    },
    "./power.css": "./dist/power.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-blocknote-css.mjs",
    "typecheck": "npm run build -w @hello-ai-company/editor-core && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench:smoke": "vitest run --config vitest.bench.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-ai-company/open-editor.git",
    "directory": "packages/blocknote"
  },
  "dependencies": {
    "@hello-ai-company/editor-core": "^0.1.0"
  },
  "peerDependencies": {
    "@blocknote/core": "^0.54.2",
    "@blocknote/react": "^0.54.2",
    "@blocknote/math-block": "^0.54.2",
    "@blocknote/diagram-block": "^0.54.2",
    "@blocknote/code-block": "^0.54.2",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@blocknote/math-block": { "optional": true },
    "@blocknote/diagram-block": { "optional": true },
    "@blocknote/code-block": { "optional": true }
  },
  "devDependencies": {
    "@blocknote/core": "0.54.2",
    "@blocknote/react": "0.54.2",
    "@blocknote/math-block": "0.54.2",
    "@blocknote/diagram-block": "0.54.2",
    "@blocknote/code-block": "0.54.2",
    "@types/node": "^22.20.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
