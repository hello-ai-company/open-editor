{
  "name": "@hello-ai-company/editor-canvas",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Responsive canvas layouts and React editing UI for OpenEditor documents.",
  "keywords": [
    "open-editor",
    "canvas",
    "responsive-layout",
    "editor"
  ],
  "homepage": "https://github.com/hello-ai-company/open-editor/tree/main/packages/canvas#readme",
  "author": "Yuki Shibata",
  "bugs": {
    "url": "https://github.com/hello-ai-company/open-editor/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run build -w @hello-ai-company/editor-core && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "npm run build -w @hello-ai-company/editor-core && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-ai-company/open-editor.git",
    "directory": "packages/canvas"
  },
  "dependencies": {
    "@hello-ai-company/editor-core": "^0.1.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
